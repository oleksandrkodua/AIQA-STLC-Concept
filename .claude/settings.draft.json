{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/.slack_webhook)",
      "Read(**/secrets/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)",
      "Read(**/.secrets/**)",
      "Read(**/.gitlab_token)",
      "Bash(*JIRA_PAT*)"
    ],
    "ask": [
      "Edit(CLAUDE.md)",
      "Edit(.claude/**)",
      "Edit(policy/**)",
      "Edit(evals/**)",
      "Bash(git push:*)",
      "Edit(plugins/qabase/**)",
      "Bash(*xray_dc_create.py*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(*rest/api*)",
      "Bash(*rest/raven*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Glob|Grep|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/deny_prod_and_secrets.py\"",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_trusted_assets.py\"",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/qa_gate.py\""
          }
        ]
      }
    ]
  }
}
